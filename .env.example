# --- Entra ID service principal (stored as a Code Engine secret) -------------------------
# Needs Contributor (or higher) on the Fabric workspace, and the tenant setting
# "Service principals can use Fabric APIs" enabled for it.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Fabric (stored as a Code Engine configmap) ------------------------------------------
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
FABRIC_WAREHOUSE_NAME=MyWarehouse
# Warehouse > Settings > SQL connection string. With workspace private link use the
# workspace-specific FQDN that your private endpoint DNS zone resolves.
FABRIC_SQL_HOST=xxxxxxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_PORT=1433
# OneLake DFS host the client uploads to (workspace-specific FQDN with workspace private link).
FABRIC_ONELAKE_HOST=onelake.dfs.fabric.microsoft.com
# Host written into the COPY INTO FROM URL (read server-side by the warehouse).
FABRIC_COPY_SOURCE_HOST=onelake.dfs.fabric.microsoft.com
# Fabric REST API, called once per run so the SPN has the control-plane token COPY INTO needs.
FABRIC_API_HOST=api.fabric.microsoft.com

# --- IBM Satellite Connector endpoints (host:port shown on each connector endpoint) -------
# Leave empty to connect directly (local runs without the tunnel).
CONNECTOR_ONELAKE_ENDPOINT=
CONNECTOR_SQL_ENDPOINT=
# Only if api.fabric.microsoft.com is not reachable publicly (tenant-level private link).
CONNECTOR_API_ENDPOINT=

# --- Test behaviour ---------------------------------------------------------------------
# Local path in the container, path on a mounted data store, or http(s) URL.
# Default (when unset) is the sample baked into the image.
#SOURCE_PARQUET=/mnt/data/my-file.parquet
# Volume test: generate N sample rows at runtime instead (overrides SOURCE_PARQUET).
#GENERATE_ROWS=1000000
TARGET_TABLE=dbo.copy_into_test
LAKEHOUSE_TARGET_DIR=copy-into-test
CLEANUP_LAKEHOUSE_FILE=false
CONNECT_TIMEOUT_SECONDS=30
# How the file gets into the warehouse table:
#   copy_into        COPY INTO from the OneLake file URL
#   lakehouse_table  staging Delta table written to the lakehouse Tables/ -> INSERT ... SELECT
#                    (use when COPY INTO fails for the SPN with error 13840)
LOAD_METHOD=copy_into
FABRIC_OPERATION_TIMEOUT_SECONDS=600
SQL_ENDPOINT_SYNC_TIMEOUT_SECONDS=300
# How COPY INTO authorizes reading the OneLake file: entra (the SPN itself) or
# workspace_identity (needs a workspace identity on the workspace, see README).
COPY_CREDENTIAL=entra
# Retries of COPY INTO on error 13840 (SPN token still propagating).
COPY_RETRIES=3
COPY_RETRY_WAIT_SECONDS=30
LOG_LEVEL=INFO
